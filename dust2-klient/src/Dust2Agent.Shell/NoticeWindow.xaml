<Window x:Class="Dust2Agent.Shell.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DUST2 bildirishnoma" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" AllowsTransparency="True"
        Background="Transparent" SizeToContent="WidthAndHeight" FontFamily="Segoe UI">

  <!--
    Seans ochiq paytda qulf oynasi yashirin bo'ladi, shuning uchun admin xabari
    va ogohlantirishlar ko'rinmay qolardi. Bu oyna o'yin ustida turadi va
    fokusni tortib olmaydi (ShowActivated="False").
  -->
  <Border x:Name="Card" CornerRadius="12" Padding="18,14" Background="#F00E121A"
          BorderBrush="#30FFFFFF" BorderThickness="1" MinWidth="320" MaxWidth="520">
    <StackPanel>
      <Grid>
        <Border x:Name="Accent" Width="4" CornerRadius="2" Background="#E0A84E"
                HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,2,12,2"/>
        <StackPanel Margin="16,0,0,0">
          <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="White"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="BodyText" FontSize="13" Foreground="#C8D2E0" TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>

      <Button x:Name="OkButton" Content="Tushunarli" HorizontalAlignment="Right"
              Margin="0,12,0,0" Padding="16,7" FontSize="13" Cursor="Hand"
              Background="#1EFFFFFF" Foreground="White" BorderBrush="#30FFFFFF"
              BorderThickness="1" Visibility="Collapsed" Click="Ok_Click"/>
    </StackPanel>
  </Border>
</Window>
